ign=left;verticalAlign=top;"><mxGeometry x="698" y="259" width="475.2" height="75" as="geometry" /></mxCell><mxCell id="c25" parent="1" value="" source_id="" original_label="" edge="1" style="endArrow=none;startArrow=none;startFill=1;dashed=0;strokeColor=#616161;"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="789" as="sourcePoint" /><mxPoint x="1228" y="789" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="c26" parent="1" value="2023 source: three untyped &lt;&lt;proxy&gt;&gt; ports. Squares omit 2011 Figure 20 port arrow glyphs.&#10;Connectors stay undirected; interface contracts, conjugation and full proxy-port semantics are not translated.&#10;Derived v2 exposes only lg1/ada for nested ends; ut3/ape_t retain private visibility." source_id="" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#555555;fontSize=16;fontStyle=0;align=left;verticalAlign=top;"><mxGeometry x="52" y="803" width="1056.0" height="69" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>