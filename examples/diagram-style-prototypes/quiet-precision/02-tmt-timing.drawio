_id="" original_label="" edge="1" style="endArrow=none;startArrow=none;startFill=1;dashed=0;strokeColor=#616161;"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="208" as="sourcePoint" /><mxPoint x="600" y="208" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="c6" parent="1" value="APS supports on-axis alignment in less than 30 minutes,&#10;at a single elevation angle, when all optics are within&#10;the alignment maintenance specifications.&#10;&#10;Full engineering conditions are retained as prose." source_id="_2ca33d85-e793-40fa-9f3a-b3c90e37fd87__17_188f7b22-cc8f-4e5c-b35c-8e3fc63198fb" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=17;fontStyle=0;align=left;verticalAlign=top;"><mxGeometry x="68" y="221" width="561.0" height="120" as="geometry" /></mxCell><mxCell id="c7" parent="1" value="REQ-2-APS-0017" source_id="_2ca33d85-e793-40fa-9f3a-b3c90e37fd87__17_188f7b22-cc8f-4e5c-b35c-8e3fc63198fb" vertex="1" style="shape=rectangle;rounded=0;fillColor=#FAFAFA;strokeColor=#616161;noLabel=1;"><mxGeometry x="52" y="143" width="548" height="228" as="geometry" /></mxCell><mxCell id="c8" parent="1" value="original modeled formalization" source_id="" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=15;fontStyle=0;align=center;verticalAlign=top;"><mxGeometry x="816.5" y="156" width="270.0" height="22" as="geometry" /></mxCell><mxCell id="c9" parent="1" value="Maintenance Alignment Maximum Time" source_id="_18_0_5_c0402fd_1464026223074_50206_149810" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=18;fontStyle=1;align=center;verticalAlign=top;"><mxGeometry x="767.9" y="177" width="367.2" height="25" as="geometry" /></mxCell><mxCell id="c10" parent="1" value="" source_id="" original_label="" edge="1" style="endArrow=none;startArrow=none;startFill=1;dashed=0;strokeColor=#616161;"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="208" as="sourcePoint" /><mxPoint x="1228" y="208" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="c11" parent="1" value="maintenanceAlignmentTimeLimit: default 1800.0 s&#10;&#10;Original class default: February 2017.&#10;A timing predicate alone does not verify the optics&#10;or elevation-angle conditions." source_id="_18_0_5_c0402fd_1464026223074_50206_149810" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=17;fontStyle=0;align=left;verticalAlign=top;"><mxGeometry x="691" y="221" width="520.1999999999999" height="120" as="geometry" /></mxCell><mxCell id="c12" parent="1" value="Maintenance Alignment Maximum Time" source_id="_18_0_5_c0402fd_1464026223074_50206_149810" vertex="1" style="shape=rectangle;rounded=0;fillColor=#FAFAFA;strokeColor=#616161;noLabel=1;"><mxGeometry x="675" y="143" width="553" height="228" as="geometry" /></mxCell><mxCell id="c13" parent="1" value="Source discrepancy: English uses &lt; 30 min; mathematical model uses &lt;= 1800 s.&#10;At exactly 1800 s the source constraint passes, while the literal English timing condition does not." source_id="" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#265DA8;fontSize=20;fontStyle=1;align=left;verticalAlign=top;"><mxGeometry x="52" y="395" width="1200.0" height="54" as="geometry" /></mxCell><mxCell id="c14" parent="1" value="peas : PEAS" source_id="_18_0_4_baa02e2_1438808102180_452510_161842" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=18;fontStyle=1;align=center;verticalAlign=top;"><mxGeometry x="172.6" y="521" width="118.8" height="25" as="geometry" /></mxCell><mxCell id="c15" parent="1" value="" source_id="" original_label="" edge="1" style="endArrow=none;startArrow=none;startFill=1;dashed=0;strokeColor=#616161;"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="552" as="sourcePoint" /><mxPoint x="412" y="552" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="c16" parent="1" value="tFinal : Real [seconds]&#10;Maintenance effect:&#10;tFinal = t1 - t0." source_id="_18_0_4_baa02e2_1438808102180_452510_161842" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=17;fontStyle=0;align=left;verticalAlign=top;"><mxGeometry x="68" y="565" width="234.6" height="72" as="geometry" /></mxCell><mxCell id="c17" parent="1" value="peas : PEAS" source_id="_18_0_4_baa02e2_1438808102180_452510_161842" vertex="1" style="shape=rectangle;rounded=0;fillColor=#F5F5F5;strokeColor=#616161;noLabel=1;"><mxGeometry x="52" y="511" width="360" height="152" as="geometry" /></mxCell><mxCell id="c18" parent="1" value="&lt;&lt;constraint&gt;&gt;" source_id="" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=15;fontStyle=0;align=center;verticalAlign=top;"><mxGeometry x="889.5" y="531" width="126.0" height="22" as="geometry" /></mxCell><mxCell id="c19" parent="1" value="maintenanceAlignment : MaxTimeConstraint" source_id="_18_0_2_baa02e2_1429562376319_87817_151513" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=18;fontStyle=1;align=center;verticalAlign=top;"><mxGeometry x="736.5" y="552" width="432.0" height="25" as="geometry" /></mxCell><mxCell id="c20" parent="1" value="" source_id="" original_label="" edge="1" style="endArrow=none;startArrow=none;startFill=1;dashed=0;strokeColor=#616161;"><mxGeometry relative="1" as="geometry"><mxPoint x="677" y="583" as="sourcePoint" /><mxPoint x="1228" y="583" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="c21" parent="1" value="p1 : Real [seconds]&#10;maxTime : Real [seconds]&#10;&#10;p1 &lt;= maxTime" source_id="_18_0_2_baa02e2_1429562376319_87817_151513" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=17;fontStyle=0;align=left;verticalAlign=top;"><mxGeometry x="693" y="596" width="244.7999999999