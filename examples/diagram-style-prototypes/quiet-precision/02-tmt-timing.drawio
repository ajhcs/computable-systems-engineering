ulation was replayed." source_id="" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=17;fontStyle=0;align=left;verticalAlign=top;"><mxGeometry x="52" y="690" width="897.6" height="48" as="geometry" /></mxCell><mxCell id="c28" parent="1" value="" source_id="" original_label="" edge="1" style="endArrow=none;startArrow=none;startFill=1;dashed=0;strokeColor=#616161;"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="789" as="sourcePoint" /><mxPoint x="1228" y="789" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="c29" parent="1" value="English-to-formalization association is documented by paper Figure 7; exact publication export is unverified.&#10;Scalar boundary checks preserve &lt;=. They do not establish full REQ-2-APS-0017 satisfaction or acceptance.&#10;New model-derived schematic; derived SysML v2 model is separately parser-validated. Original figures are linked." source_id="" vertex="1" style="text;html=0;strokeColor=none;fillColor=none;fontColor=#555555;fontSize=16;fontStyle=0;align=left;verticalAlign=top;"><mxGeometry x="52" y="803" width="1075.2" height="69" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>